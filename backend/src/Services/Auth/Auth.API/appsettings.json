{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "exe-auth",
    "Audience": "exe-api",
    "Key": "",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Outbox": {
    "BatchSize": 20,
    "PollIntervalSeconds": 2,
    "MaxRetryCount": 5,
    "ErrorBackoffSeconds": 5
  }
}
