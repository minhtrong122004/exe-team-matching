{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "exe-auth",
    "Audience": "exe-api",
    "Key": ""
  },
  "UserConsumer": {
    "StreamName": "exe:events:UserRegistered",
    "ConsumerGroup": "user-service",
    "ConsumerName": "user-service-worker-1",
    "DeadLetterStreamName": "exe:deadletter:UserRegistered",
    "BatchSize": 10,
    "PollIntervalMs": 1000,
    "PendingCheckIntervalMs": 15000,
    "PendingMinIdleMs": 10000,
    "MaxRetryCount": 5
  }
}
