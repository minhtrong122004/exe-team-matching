{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users": {
        "ClusterId": "user",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "users-root": {
        "ClusterId": "user",
        "Match": {
          "Path": "/api/users"
        }
      },
      "skills": {
        "ClusterId": "user",
        "Match": {
          "Path": "/api/skills/{**catch-all}"
        }
      },
      "skills-root": {
        "ClusterId": "user",
        "Match": {
          "Path": "/api/skills"
        }
      },
      "projects": {
        "ClusterId": "project",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "projects-root": {
        "ClusterId": "project",
        "Match": {
          "Path": "/api/projects"
        }
      },
      "groups": {
        "ClusterId": "group",
        "Match": {
          "Path": "/api/groups/{**catch-all}"
        }
      },
      "groups-root": {
        "ClusterId": "group",
        "Match": {
          "Path": "/api/groups"
        }
      },
      "join-requests": {
        "ClusterId": "group",
        "Match": {
          "Path": "/api/join-requests/{**catch-all}"
        }
      },
      "invitations": {
        "ClusterId": "group",
        "Match": {
          "Path": "/api/invitations/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "reports": {
        "ClusterId": "report",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "user": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "project": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "group": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5006/"
          }
        }
      },
      "report": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5007/"
          }
        }
      }
    }
  }
}
