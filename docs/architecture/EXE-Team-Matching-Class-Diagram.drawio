        <mxCell id="admin" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«service»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;AdminAccountService : IAdminAccountService&lt;/div&gt;&lt;hr&gt;+ GetAccountsPagedAsync()&lt;br&gt;+ LockAccountAsync() / UnlockAccountAsync()&lt;br&gt;+ CreateLecturerAsync()&lt;br&gt;+ ProvisionFapStudentsAsync()&lt;br&gt;- transactional account + OutboxMessage writes" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;fillColor=#fff4ed;align=left;" vertex="1" parent="1">
          <mxGeometry x="625" y="420" width="465" height="205" as="geometry"/>
        </mxCell>
        <mxCell id="validator" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«validator»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;Auth request validators&lt;/div&gt;&lt;hr&gt;GoogleLoginRequestValidator&lt;br&gt;RefreshTokenRequestValidator · LogoutRequestValidator&lt;br&gt;CreateLecturerRequestValidator&lt;br&gt;ProvisionFapStudentsRequestValidator" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;fillColor=#fffaf5;align=left;" vertex="1" parent="1">
