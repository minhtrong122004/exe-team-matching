        <mxCell id="pr_title" value="PROJECT SERVICE — PROJECT IDEAS &amp; TAGS" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#68738a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="45" y="25" width="1550" height="28" as="geometry"/>
