          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="gse5" value="business rules + persistence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#68758a;dashed=1;endArrow=open;" edge="1" parent="1" source="gss" target="sp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="gsrule" value="&lt;div style=&quot;font-weight:bold;font-size:15px;color:#b94a12&quot;&gt;Business rules in CourseSpaceService&lt;/div&gt;&lt;br&gt;Room count = ceil(enrollment count ÷ MaxMembersPerGroup × BufferRatio). RoomCode is &lt;SemesterCode&gt;&lt;SubjectCode&gt;-&lt;sequence&gt;. Import persists eligibility rows and calls Auth provisioning; do not model StudentId as cross-database FK. RegistrationDeadlineWorker changes Open → ClosedRegistration. Profile-completion consumer updates enrollment read model." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;fontColor=#46556f;strokeColor=#cbd5e1;strokeWidth=1;fillColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="1180" y="700" width="470" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="gslegend" value="&lt;div style=&quot;font-weight:bold;font-size:15px;color:#b94a12&quot;&gt;UML relationship rule&lt;/div&gt;&lt;br&gt;Solid association + multiplicity means EF navigation/FK in ExeGroupDb. The StudentId/LeaderId/ProjectId fields are scalar references into other service databases, not relational associations." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;fontColor=#46556f;strokeColor=#cbd5e1;strokeWidth=1;fillColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="50" y="965" width="1600" height="65" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
