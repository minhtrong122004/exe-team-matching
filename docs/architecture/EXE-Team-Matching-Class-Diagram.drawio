        <mxCell id="room" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«entity»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;GroupEntity (Room / Group)&lt;/div&gt;&lt;hr&gt;PK Id · FK SpaceId?&lt;br&gt;RoomCode? · Name · Description?&lt;br&gt;LeaderId? (logical) · ProjectId? (logical)&lt;br&gt;MaxMembers · Status · IsClosedByLeader · RowVersion" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;strokeWidth=1.3;align=left;" vertex="1" parent="1">
          <mxGeometry x="625" y="730" width="440" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="gse3" value="1 — 0..* enrollments" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#52647f;endArrow=none;startArrow=none;" edge="1" parent="1" source="sp" target="en">
          <mxGeometry relative="1" as="geometry"/>
