        <mxCell id="j3" value="1 — 0..* votes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#52647f;endArrow=none;startArrow=none;" edge="1" parent="1" source="join" target="avote">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="j4" value="1 — 0..* votes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#52647f;endArrow=none;startArrow=none;" edge="1" parent="1" source="elect" target="evote">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="j5" value="creates / decides" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#68758a;dashed=1;endArrow=open;" edge="1" parent="1" source="jservice" target="join">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="creates / decides" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#68758a;dashed=1;endArrow=open;" edge="1" parent="1" source="tservice" target="transfer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="wrules" value="&lt;div style=&quot;font-weight:bold;font-size:15px;color:#b94a12&quot;&gt;Rule placement and outcome&lt;/div&gt;&lt;br&gt;Only Recruiting groups accept applications. Student must be eligible/enrolled, have completed profile, not already belong to a group in that space, and stay under MaxConcurrentApplies. Application votes are consultative; Leader makes final accept/reject. Accept adds membership transactionally, cancels the student’s other pending applications, and capacity/early-close rules reject pending requests. Transfer after lock is moderator-approved; target needs capacity, and source must remain at/above threshold unless swapped." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;fontColor=#46556f;strokeColor=#cbd5e1;strokeWidth=1;fillColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="40" y="815" width="640" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="erules" value="&lt;div style=&quot;font-weight:bold;font-size:15px;color:#b94a12&quot;&gt;Leader election&lt;/div&gt;&lt;br&gt;ElectionService (not a separate controller class) lets a current member nominate another member. One active election per group; each member one vote; &gt;50% of all members passes; 24h expiry or all votes without majority fails. A passed election updates GroupMember.Role and GroupEntity.LeaderId." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;fontColor=#46556f;strokeColor=#cbd5e1;strokeWidth=1;fillColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="1270" y="835" width="400" height="205" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
