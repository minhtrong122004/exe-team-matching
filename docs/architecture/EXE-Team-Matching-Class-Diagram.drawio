        <mxCell id="arules" value="&lt;div style=&quot;font-weight:bold;font-size:15px;color:#b94a12&quot;&gt;Rule placement&lt;/div&gt;&lt;br&gt;Google email must resolve to a pre-provisioned active Account. Refresh rotation stores only token hashes; reuse of a revoked replaced token revokes all refresh sessions. AcceptTermsAt records BR-34. Account lock blocks future login/refresh; existing access JWT remains stateless until expiry." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;fontColor=#46556f;strokeColor=#cbd5e1;strokeWidth=1;fillColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="50" y="925" width="1610" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
