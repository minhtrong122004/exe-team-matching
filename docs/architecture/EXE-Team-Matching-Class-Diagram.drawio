        <mxCell id="security" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«security interface / implementation»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;ITokenService → TokenService&lt;br&gt;IGoogleTokenVerifier → GoogleTokenVerifier&lt;/div&gt;&lt;hr&gt;Access JWT HS256 · refresh token random value&lt;br&gt;persist SHA-256 hash only&lt;br&gt;Google ID token signature / audience / expiry verification" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;fillColor=#f8faff;align=left;" vertex="1" parent="1">
