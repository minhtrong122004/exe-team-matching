  <diagram id="matching" name="09 Matching gRPC Service">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ma_title" value="MATCHING SERVICE — gRPC CONTRACT, RANKING, DISTRIBUTION &amp; AI MENTOR" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#68738a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="45" y="25" width="1600" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="ma_client" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«client service»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;GroupMatchingService&lt;/div&gt;&lt;hr&gt;Loads student/profile, group slots and project data&lt;br&gt;+ GetMatchScoreAsync() · GetSuggestionsAsync()&lt;br&gt;+ GetCandidatesAsync() · GetAiMentorInsightsAsync()&lt;br&gt;Calls IMatchingClient over gRPC" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;fillColor=#fff4ed;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="105" width="440" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="ma_proto" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«protobuf contract»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;MatchingService (matching.proto)&lt;/div&gt;&lt;hr&gt;RPC: CalculateMatch · RankGroups · RankCandidates&lt;br&gt;DistributeUnmatchedStudents · AnalyzeGroupWithAI&lt;br&gt;Messages: StudentProfile · GroupNeed · MatchResult&lt;br&gt;Distribution request/plan · AI analysis request/response" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;fillColor=#f8faff;align=left;" vertex="1" parent="1">
          <mxGeometry x="625" y="105" width="465" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="ma_grpc" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«gRPC endpoint»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;MatchingGrpcService&lt;/div&gt;&lt;hr&gt;Maps protobuf ↔ domain models&lt;br&gt;Delegates calculator and AI mentor&lt;br&gt;No domain persistence" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;fillColor=#fff4ed;align=left;" vertex="1" parent="1">
          <mxGeometry x="1230" y="105" width="420" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="mae1" value="gRPC request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#7351a6;endArrow=block;endFill=1;" edge="1" parent="1" source="ma_client" target="ma_proto">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mae2" value="implements RPC contract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#7351a6;endArrow=block;endFill=1;" edge="1" parent="1" source="ma_proto" target="ma_grpc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ma_calci" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«service interface / implementation»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;IMatchingCalculator → MatchingCalculator&lt;/div&gt;&lt;hr&gt;Calculate() · RankGroups() · RankCandidates()&lt;br&gt;DistributeUnmatchedStudents()&lt;br&gt;Stateless; deterministic tie-breaks" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;fillColor=#fff4ed;align=left;" vertex="1" parent="1">
          <mxGeometry x="625" y="405" width="465" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="ma_ai" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«service interface / implementation»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;IAiMentorService → AiMentorService&lt;/div&gt;&lt;hr&gt;AnalyzeGroupAsync()&lt;br&gt;Gemini API when configured; heuristic fallback&lt;br&gt;Timeout + parse/response fallback" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;fillColor=#fff4ed;align=left;" vertex="1" parent="1">
          <mxGeometry x="1230" y="405" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="mae3" value="delegates scoring/distribution" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#f36b2b;endArrow=block;endFill=1;" edge="1" parent="1" source="ma_grpc" target="ma_calci">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mae4" value="delegates AI analysis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#f36b2b;endArrow=block;endFill=1;" edge="1" parent="1" source="ma_grpc" target="ma_ai">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="studentinput" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«input model»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;StudentInput&lt;/div&gt;&lt;hr&gt;UserId · Major · Skills · Interests&lt;br&gt;Five fixed numeric skill scores" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;strokeWidth=1.3;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="groupinput" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«input model»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;GroupInput&lt;/div&gt;&lt;hr&gt;GroupId · RequiredMajors/Skills&lt;br&gt;ProjectDomain · average five skill scores" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;strokeWidth=1.3;align=left;" vertex="1" parent="1">
          <mxGeometry x="430" y="700" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="outcomes" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«output models»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;MatchOutcome / distribution outcomes&lt;/div&gt;&lt;hr&gt;Score (0..100) · MatchedSkills · MissingSkills&lt;br&gt;RoomPlan · assignments · balance score" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;strokeWidth=1.3;align=left;" vertex="1" parent="1">
          <mxGeometry x="810" y="700" width="350" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="weights" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«configuration»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;MatchingWeights&lt;/div&gt;&lt;hr&gt;Skill=50 · Major=30 · Domain=20&lt;br&gt;Weights must total 100" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;fillColor=#f8faff;align=left;" vertex="1" parent="1">
          <mxGeometry x="1230" y="700" width="420" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mae5" value="input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#68758a;dashed=1;endArrow=open;" edge="1" parent="1" source="studentinput" target="ma_calci">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mae6" value="input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#68758a;dashed=1;endArrow=open;" edge="1" parent="1" source="groupinput" target="ma_calci">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mae7" value="returns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#68758a;dashed=1;endArrow=open;" edge="1" parent="1" source="ma_calci" target="outcomes">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mae8" value="configuration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.4;strokeColor=#68758a;dashed=1;endArrow=open;" edge="1" parent="1" source="weights" target="ma_calci">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="marule" value="&lt;div style=&quot;font-weight:bold;font-size:15px;color:#b94a12&quot;&gt;Algorithms&lt;/div&gt;&lt;br&gt;Match score combines weighted skill, major and domain fits (default weights 50/30/20); numeric skill deficit compensation supplements named-skill overlap. Distribution fills existing partial rooms first, uses balancing/skill-major fitness for unmatched students, forms new groups only at/above threshold, preserves existing leaders and selects new leader by ManagementScore (then total score / StudentCode tie-break). Matching is advisory/planning: Group Service confirms changes." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;fontColor=#46556f;strokeColor=#cbd5e1;strokeWidth=1;fillColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="50" y="900" width="1600" height="125" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
