        <mxCell id="proce" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«entity»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;ProcessedEvent&lt;/div&gt;&lt;hr&gt;PK EventId · ProcessedAt&lt;br&gt;Idempotency ledger" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;strokeWidth=1.3;align=left;" vertex="1" parent="1">
          <mxGeometry x="1280" y="690" width="370" height="120" as="geometry"/>
