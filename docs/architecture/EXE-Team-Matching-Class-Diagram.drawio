  <diagram id="auth" name="01 Auth Service">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="auth_title" value="AUTH SERVICE — IDENTITY, SESSION &amp; PROVISIONING" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#68738a;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="45" y="25" width="1550" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="ac" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«controller»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;AuthController&lt;/div&gt;&lt;hr&gt;+ LoginWithGoogle()&lt;br&gt;+ Refresh()&lt;br&gt;+ Logout()&lt;br&gt;+ GetCurrentUser()&lt;br&gt;+ AcceptTerms()&lt;br&gt;+ GetAccounts() / Lock / Unlock&lt;br&gt;+ CreateLecturer() / ProvisionFapStudents()" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="105" width="420" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="as" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«service»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;AuthService : IAuthService&lt;/div&gt;&lt;hr&gt;- IAccountRepository · IRefreshTokenRepository&lt;br&gt;- IUnitOfWork · ITokenService&lt;br&gt;- IGoogleTokenVerifier · request validators&lt;br&gt;+ LoginWithGoogleAsync()&lt;br&gt;+ RefreshTokenAsync() · LogoutAsync()&lt;br&gt;+ AcceptTermsAsync() · GetCurrentAccountAsync()" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;fillColor=#fff4ed;align=left;" vertex="1" parent="1">
          <mxGeometry x="625" y="105" width="465" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="aar" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«repository»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;AccountRepository / RefreshTokenRepository&lt;/div&gt;&lt;hr&gt;+ GetByEmailAsync() · GetByIdAsync()&lt;br&gt;+ GetByTokenHashAsync()&lt;br&gt;+ AddAsync() · UpdateAsync()&lt;br&gt;+ RevokeAllForAccountAsync()" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;align=left;" vertex="1" parent="1">
          <mxGeometry x="1230" y="105" width="420" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="ae1" value="calls application service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#f36b2b;endArrow=block;endFill=1;" edge="1" parent="1" source="ac" target="as">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ae2" value="repository interfaces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#f36b2b;endArrow=block;endFill=1;" edge="1" parent="1" source="as" target="aar">
