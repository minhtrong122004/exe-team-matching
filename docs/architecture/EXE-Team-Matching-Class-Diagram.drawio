        <mxCell id="spa" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«frontend»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;React Web App&lt;/div&gt;&lt;hr&gt;App.tsx · role-based routes&lt;br&gt;Profile · spaces/rooms · groups/applications&lt;br&gt;moderator distribution/transfers · reports" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=14;fontFamily=Arial;fontColor=#26334b;strokeColor=#8294b4;strokeWidth=1.5;fillColor=#f4f7fc;align=left;" vertex="1" parent="1">
