        <mxCell id="gmc" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«controller»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;GroupsController&lt;/div&gt;&lt;hr&gt;+ DirectJoinRoom() · LeaveGroup()&lt;br&gt;+ RemoveMember() · TransferLeader()&lt;br&gt;+ CloseRecruitment() · ReopenRecruitment()&lt;br&gt;+ StartElection() · VoteElection() · GetCurrentElection()" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;align=left;" vertex="1" parent="1">
