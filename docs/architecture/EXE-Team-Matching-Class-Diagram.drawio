        <mxCell id="prc" value="&lt;div style=&quot;text-align:center;color:#777;font-size:13px&quot;&gt;«controller»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-size:18px&quot;&gt;ProjectsController&lt;/div&gt;&lt;hr&gt;+ GetProjects() · GetProjectById()&lt;br&gt;+ CreateProject() · UpdateProject()&lt;br&gt;+ DeleteProject()" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontSize=13;fontFamily=Arial;fontColor=#252b37;strokeColor=#ff641f;strokeWidth=1.5;fillColor=#ffffff;align=left;" vertex="1" parent="1">
