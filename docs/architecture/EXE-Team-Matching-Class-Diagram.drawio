        <mxCell id="nte6" value="sends SMTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#f36b2b;endArrow=block;endFill=1;" edge="1" parent="1" source="worker" target="smtp">
