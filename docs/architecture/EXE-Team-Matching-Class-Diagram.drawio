        <mxCell id="s_scope" value="&lt;div style=&quot;font-weight:bold;font-size:15px;color:#b94a12&quot;&gt;Phạm vi&lt;/div&gt;&lt;br&gt;Ứng dụng ghép nhóm cho EXE101 / EXE201 theo kỳ học; 3 vai trò Student, Moderator, Lecturer. Frontend gọi REST qua YARP; Group là core nghiệp vụ. Mỗi REST service sở hữu database riêng." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;fontColor=#46556f;strokeColor=#cbd5e1;strokeWidth=1;fillColor=#f8fafc;" vertex="1" parent="1">
