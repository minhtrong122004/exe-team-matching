        <mxCell id="gmrules" value="&lt;div style=&quot;font-weight:bold;font-size:15px;color:#b94a12&quot;&gt;State &amp; concurrency rules&lt;/div&gt;&lt;br&gt;Empty → Forming → Recruiting → Closed → Locked; implementation enum also includes Disbanded. First direct join becomes temporary Leader. At threshold, direct join closes and Apply is required. Leader leave promotes earliest JoinedAt; empty group loses Leader. Below threshold returns to Forming. RowVersion + retry guards simultaneous joins." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Arial;fontColor=#46556f;strokeColor=#cbd5e1;strokeWidth=1;fillColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="50" y="875" width="1610" height="150" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
