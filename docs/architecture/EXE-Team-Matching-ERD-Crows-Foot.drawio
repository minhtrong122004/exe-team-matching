<mxfile host="app.diagrams.net" modified="2026-11-11T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram name="01 ExeGroupDb" id="01-exegroupdb"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="EXE Team Matching | ExeGroupDb" style="text;html=1;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#16324F;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="22" width="1730" height="44" /></mxCell><mxCell id="note" value="Chỉ hiển thị thực thể và quan hệ FK của ExeGroupDb. StudentId, UserId, LeaderId, VoterId, ProjectId là ID logic ngoài DB. SpaceId của Group nullable; các FK FromGroupId/TargetGroupId bắt buộc." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="68" width="1730" height="55" /></mxCell><mxCell id="cs" value="CourseSpace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16324F;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#16324F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="230" width="220" height="72" /></mxCell><mxCell id="en" value="SpaceEnrollment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16324F;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#16324F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="150" width="240" height="72" /></mxCell><mxCell id="g" value="Group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16324F;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#16324F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="390" width="240" height="72" /></mxCell><mxCell id="tr" val