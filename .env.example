# Copy file này thành .env rồi đổi giá trị. KHÔNG commit file .env.

# Mật khẩu SA của SQL Server (tối thiểu 8 ký tự, có chữ hoa, chữ thường, số, ký tự đặc biệt)
SA_PASSWORD=Exe@Passw0rd2025

# Key ký JWT dùng chung cho Auth, Gateway và các service (tối thiểu 32 ký tự)
JWT_KEY=dev-only-jwt-key-change-me-0123456789abcdef

# Brevo Transactional Email Configuration (Cấu hình OTP Email)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@gmail.com
BREVO_SENDER_NAME=PRN232 EXE Team Matching
BREVO_ENABLE_REAL_EMAIL=true
Brevo__ApiKey=your_brevo_api_key_here
Brevo__SenderEmail=your_verified_sender_email@gmail.com
Brevo__SenderName=PRN232 EXE Team Matching
Brevo__EnableRealEmail=true
